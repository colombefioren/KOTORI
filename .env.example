# ── Model endpoint (any OpenAI-compatible API) ────────────────────────────────
# Required. The studio refuses to open a story without a key.
MODEL_NAME=gpt-4o-mini
API_KEY=sk-your-key-here
# Leave empty for OpenAI, or point at Groq / OpenRouter / Ollama / vLLM.
BASE_URL=https://api.openai.com/v1

# ── Generation defaults (optional) ───────────────────────────────────────────
TEMPERATURE=0.9
MAX_TOKENS=900
REQUEST_TIMEOUT=60

# ── Studio settings (optional) ───────────────────────────────────────────────
# Where the JSONL archive and rendered audio are written.
AI_STORYTELLER_DATA_DIR=data
# The studio is light by design; set to 0 only to let Gradio theme itself.
FORCE_LIGHT=1

# ── Server (optional, useful for Docker / Spaces) ────────────────────────────
PORT=7860
GRADIO_SERVER_NAME=0.0.0.0
