# ── The writer (any OpenAI-compatible API) ────────────────────────────────────
# Optional: without a key the studio runs on its demo reels.
MODEL_NAME=gpt-4o-mini
API_KEY=sk-your-key-here
# Leave empty for OpenAI, or point at the gateway of your choice.
BASE_URL=https://api.openai.com/v1

# ── Generation defaults (optional) ───────────────────────────────────────────
TEMPERATURE=0.9
MAX_TOKENS=900
REQUEST_TIMEOUT=60

# ── Studio settings (optional) ───────────────────────────────────────────────
# Where the JSONL archive and rendered audio are written.
KOTORI_DATA_DIR=data
# Which desk the studio opens on: "light" (paper) or "dark" (night desk).
# Visitors can switch it themselves; this is only the first impression.
KOTORI_THEME=light

# ── Server (optional, useful for Docker / Spaces) ────────────────────────────
PORT=7860
GRADIO_SERVER_NAME=0.0.0.0
